{
  "name": "conquest",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "scripts/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:search": "npm run dev -w services/search-api",
    "dev:game": "npm run dev -w services/game-api",
    "dev:web": "npm run dev -w apps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
