# Copy to .env and fill in. Never commit .env. On the cluster these live in Secret conquest-secrets.
DEPLOY_ENV=dev

# Elasticsearch (search-api and game-api)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# OpenAI (game-api themes/class/recap, search-api embeddings). Unset = deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# game-api and web -> search-api, web -> game-api (web proxies /api/* to these)
SEARCH_API_URL=http://localhost:4001
# game-api: 1 = answer from contracts fixtures instead of calling search-api (also used when SEARCH_API_URL is unset)
FAKE_SEARCH=
GAME_API_URL=http://localhost:4002

# Service ports (local dev)
SEARCH_API_PORT=4001
GAME_API_PORT=4002

# OpenTelemetry: services export OTLP straight to Dash0 (no collector). Unset endpoint = telemetry off.
# e.g. https://ingress.<region>.dash0.com
OTEL_EXPORTER_OTLP_ENDPOINT=
# Either set OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>, or just DASH0_AUTH_TOKEN and
# packages/telemetry builds the header.
OTEL_EXPORTER_OTLP_HEADERS=
DASH0_AUTH_TOKEN=
DASH0_DATASET=

# Web
NEXT_PUBLIC_FAKE_API=1
NEXT_PUBLIC_DASH0_RUM_ENDPOINT=
NEXT_PUBLIC_DASH0_RUM_AUTH_TOKEN=
NEXT_PUBLIC_DASH0_DASHBOARD_URL=
