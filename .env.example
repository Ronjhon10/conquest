# Copy to .env and fill in. Never commit .env. On the cluster these live in Secret conquest-secrets.
DEPLOY_ENV=dev

# Elasticsearch (search-api and game-api)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# OpenAI (game-api themes/class/recap, search-api embeddings). Unset = deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# game-api -> search-api
SEARCH_API_URL=http://localhost:4001

# Service ports (local dev)
SEARCH_API_PORT=4001
GAME_API_PORT=4002

# OpenTelemetry: services send to the collector. Unset = telemetry off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Collector only (never in services):
DASH0_AUTH_TOKEN=
DASH0_ENDPOINT=

# Web
NEXT_PUBLIC_FAKE_API=1
NEXT_PUBLIC_DASH0_RUM_ENDPOINT=
NEXT_PUBLIC_DASH0_RUM_AUTH_TOKEN=
NEXT_PUBLIC_DASH0_DASHBOARD_URL=
