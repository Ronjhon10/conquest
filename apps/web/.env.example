# Copy to apps/web/.env.local. Next reads env files from apps/web, not the repo root.
NEXT_PUBLIC_FAKE_API=1

# Enable "Sign In with LinkedIn using OpenID Connect" on a LinkedIn developer app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# Generate once: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
LINKEDIN_COOKIE_SECRET=
